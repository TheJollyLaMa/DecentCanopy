# DecentCanopy — Environment Configuration
#
# Copy this file to .env and fill in the values for your deployment.
# The .env file is git-ignored; never commit real secrets or keys.
#
# NOTE: DecentCanopy runs entirely client-side (static HTML/JS/CSS).
# These variables are used for documentation purposes and for any
# future build-tool or server-side tooling that reads from .env.

# ---- Network / RPC -------------------------------------------------------

# Default EVM chain ID used in app mode (1 = Ethereum mainnet)
DECENTCANOPY_DEFAULT_CHAIN_ID=1

# Comma-separated list of supported chain IDs
DECENTCANOPY_SUPPORTED_CHAIN_IDS=1,10,8453

# JSON-RPC provider URL(s) — one per supported network
# Obtain endpoints from Alchemy, Infura, QuickNode, or a public RPC gateway.
DECENTCANOPY_RPC_MAINNET=
DECENTCANOPY_RPC_OPTIMISM=
DECENTCANOPY_RPC_BASE=

# ---- Contract Addresses --------------------------------------------------
# Fill these in once your contracts are deployed.
# See scripts/config.js — GTPConfig.contracts — to wire them at runtime.

# Ethereum mainnet (chain 1)
DECENTCANOPY_CONTRACT_PROJECT_REGISTRY_1=
DECENTCANOPY_CONTRACT_TREASURY_1=
DECENTCANOPY_CONTRACT_PROFILE_REGISTRY_1=

# Optimism (chain 10)
DECENTCANOPY_CONTRACT_PROJECT_REGISTRY_10=
DECENTCANOPY_CONTRACT_TREASURY_10=
DECENTCANOPY_CONTRACT_PROFILE_REGISTRY_10=

# Base (chain 8453)
DECENTCANOPY_CONTRACT_PROJECT_REGISTRY_8453=
DECENTCANOPY_CONTRACT_TREASURY_8453=
DECENTCANOPY_CONTRACT_PROFILE_REGISTRY_8453=
